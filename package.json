{
  "name": "@analoguezone/remote-command-mcp",
  "version": "1.1.0-marker-based",
  "description": "MCP server for executing commands on remote hosts seamlessly with OpenCode and other AI coding assistants",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "remote-command-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "src/bootstrap/**/*",
    "config/remotes.example.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analoguezone/remote-command.git"
  },
  "scripts": {
    "build": "tsc && npm run copy-bootstrap && npm run copy-package",
    "copy-bootstrap": "mkdir -p dist/bootstrap && cp src/bootstrap/*.sh dist/bootstrap/",
    "copy-package": "cp package.json dist/package.json",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "claude-code",
    "remote",
    "ssh",
    "tmux",
    "command-execution",
    "warp",
    "warpify",
    "ai-coding-assistant"
  ],
  "author": "analoguezone",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "ssh2": "^1.15.0",
    "ssh2-streams": "^0.4.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
